  "quest.0F28F8848E017312.title": "Aquarium",
  "quest.0F28F8848E017312.quest_desc": [
    "Aquarium block for aquatic mobs caught with Aquatic Jars.",
    "",
    "Functions like an Animal Pen for water creatures: automate bucket fills, dye tropical fish, harvest ink, and trigger advancement-style interactions from one block.",
    "",
    "Place near your mob farm output so random-block fish drops become a steady resource line."
  ],
  "task.B4B129D182E046EB.title": "Obtain Aquarium",
  "quest.2EF823FC5D7AD5C5.title": "Iron Aviary",
  "quest.2EF823FC5D7AD5C5.quest_desc": [
    "Iron Aviary \u2014 aerial counterpart to the Animal Pen. Accepts filled Avian Nets.",
    "",
    "Process flying mobs for honey bottles, honeycomb, feathers, and pollen in a compact skyblock-friendly building.",
    "",
    "Upgrade path continues through copper oxidation tiers for the same modpack prestige look as vanilla copper builds."
  ],
  "task.85860F382FFEE0A6.title": "Obtain Iron Aviary",
  "quest.A1D1F153E28F0E0C.title": "Copper Aviary",
  "quest.A1D1F153E28F0E0C.quest_desc": [
    "Copper Aviary \u2014 aviary block variant (base copper tier).",
    "",
    "Same function as the Iron Aviary: insert Avian Nets and farm flying mob drops. Cosmetic tier differences only unless your pack adds special recipes.",
    "",
    "Waxed variants stay at their oxidation stage forever \u2014 great for build consistency on long skyblock worlds."
  ],
