{
  "chapter.50514D842EDCA873.title": "Animal Pens",
  "quest.B44489EC6EB14CE8.title": "Animal Cage",
  "quest.B44489EC6EB14CE8.quest_desc": [
    "Portable mob catcher for land animals. Right-click a compatible animal to store it; sneak + right-click a block to release.",
    "",
    "Place filled cages inside an Animal Pen block to milk, shear, breed, and harvest drops without laggy entity farms on your skyblock.",
    "",
    "Cannot catch babies, tamed mobs, or animals wearing chests. Check JEI for the full capturable list."
  ],
  "task.040D6E7BE4554820.title": "Obtain Animal Cage",
  "quest.2A24B6D9D7C6EE82.title": "Filled Animal Cage",
  "quest.2A24B6D9D7C6EE82.quest_desc": [
    "An Animal Cage that already holds at least one captured mob variant.",
    "",
    "Craft an empty cage first, then right-click animals in the world until the cage stores them. Sneak + right-click to release; place in an Animal Pen to start automated interactions.",
    "",
    "Each cage tracks entity type and variant count \u2014 useful for stocking pens before your random block spawns every species."
  ],
  "task.0ABD623049E2FD23.title": "Obtain Filled Animal Cage",
  "quest.992BFBAC21D0F8A8.title": "Avian Net",
  "quest.992BFBAC21D0F8A8.quest_desc": [
    "Avian Net \u2014 captures flying mobs like parrots, bats, bees, and allays. Same controls as the Animal Cage: right-click to catch, sneak + right-click to release.",
    "",
    "Insert into an Aviary block (iron or copper tiers) to farm feathers, honey, pollen, and other aerial drops compactly.",
    "",
    "JEI lists every flier this net accepts on your pack version."
  ],
  "task.93995B4CCCD887CC.title": "Obtain Avian Net",
  "quest.6D66C3FDF3145D56.title": "Filled Avian Net",
  "quest.6D66C3FDF3145D56.quest_desc": [
    "An Avian Net already storing captured flying mobs.",
    "",
    "Catch your first bat or parrot from random-block mob drops, then slot the filled net into an Aviary. Variant storage works like land cages \u2014 one net, multiple colors or types where allowed."
  ],
  "task.4BF885A3BA427D81.title": "Obtain Filled Avian Net",
  "quest.1C7FED3D2D265AC5.title": "Aquatic Jar",
  "quest.1C7FED3D2D265AC5.quest_desc": [
    "Aquatic Jar for catching water mobs: fish, squid, dolphins, axolotls, turtles, and more.",
    "",
    "Right-click aquatic creatures, sneak + right-click to release, then place in an Aquarium block for bucket-style interactions without draining your island pond.",
    "",
    "Pairs with the Aquarium multiblock \u2014 essential when your one-block island has limited water space."
  ],
  "task.2A7F40E78B27E6F3.title": "Obtain Aquatic Jar",
  "quest.5C7DE1E6C4E76098.title": "Filled Aquatic Jar",
  "quest.5C7DE1E6C4E76098.quest_desc": [
    "A filled Aquatic Jar ready for an Aquarium.",
    "",
    "Catch cod, salmon, tropical fish, or axolotls from random-block water loot, then transfer the jar into an Aquarium to farm buckets, bonemeal sources, and prismarine ingredients."
  ],
  "task.FA076457CA3A9F79.title": "Obtain Filled Aquatic Jar",
  "quest.6FD86CF67020148A.title": "Animal Pen",
  "quest.6FD86CF67020148A.quest_desc": [
    "Acacia Animal Pen \u2014 placeable habitat for land animals stored in Animal Cages.",
    "",
    "Insert a filled Animal Cage, open the GUI, and interact with mobs for milk, wool, eggs, stew, and breeding \u2014 all without entity cramming on your platform.",
    "",
    "Wood type is acacia \u2014 pick the variant that matches your base aesthetic. Mechanics are identical across wood types."
  ],
