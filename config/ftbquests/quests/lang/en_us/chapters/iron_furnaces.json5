  "quest.432945B92901C276.quest_desc": [
    "Furnace Spooka-lator — Halloween cosmetic fun. Shapeless recipe: carved pumpkin plus furnace.",
    "",
    "Right-click any Iron Furnaces block to spookalize it. Sneak + right-click with the Spooka-lator to cleanse the spookiness.",
    "",
    "Purely cosmetic — 3spooky5me. Does not affect smelting speed or augments.",
  ],
  "quest.7C83318981ED790C.quest_desc": [
    "Furnace Wrapping Papers — holiday gift wrap for furnaces. Paper, red dye, yellow dye, and a furnace.",
    "",
    "Right-click a furnace to wrap it as a present. Sneak + right-click to unwrap.",
    "",
    "Cosmetic only — yes, the paper would catch fire in real life. Your skyblock base can still look festive.",
  ],
