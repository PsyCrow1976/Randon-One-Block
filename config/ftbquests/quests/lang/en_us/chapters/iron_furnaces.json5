  "quest.4ACBA245D846438E.quest_desc": [
    "End-game smelting before netherite. Obsidian frame with blaze rods on the sides and an emerald furnace in the center.",
    "",
    "20-tick smelts — ten times faster than vanilla — and 500 RF/tick generation. Tier 2 energy tier.",
    "",
    "Two upgrade routes: Emerald to Obsidian or Crystal to Obsidian. Stock blaze rods from mob drops or random-block loot.",
  ],
  "quest.04D7C76007348E46.quest_desc": [
    "Wireless Heat Transmitter — a central FE hub for remote furnace fueling. Stone, comparator, redstone block, and a furnace in the recipe.",
    "",
    "Place and supply with Forge Energy. Link Wireless Heat Receivers by inserting them into the transmitter GUI.",
    "",
    "Powers all bound receivers simultaneously — run long smelting lines without routing fuel pipes to every machine.",
  ],
  "quest.4ACBA245D846438E.title": "Obsidian Furnace",
  "quest.3D4440032F9BAFC5.quest_desc": [
    "Obtain Upgrade Iron.",
  ],
  "quest.750C98658E184B97.quest_desc": [
    "An early alternative to the Iron Furnace when copper is plentiful. Eight copper ingots around a vanilla furnace.",
    "",
    "Slightly slower than iron (180 ticks) but still faster than vanilla. Tier 0 — same energy buffer class as iron.",
    "",
    "Use the Stone to Copper upgrade on a placed furnace, or craft directly once you have the ingots from your random block pool.",
  ],
