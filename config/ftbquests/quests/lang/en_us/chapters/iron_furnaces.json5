  "quest.7A561DE76B26741B.quest_desc": [
    "Converts the furnace into a multi-slot factory. Piston center with paper, redstone, and stone.",
    "",
    "Pro: parallel smelting lanes in one block. Con: uses power for heat instead of traditional fuel.",
    "",
    "Best on tier 1+ furnaces with wireless heat or a Generator augment feeding FE back into the network.",
  ],
  "task.59ECB20974FC2769.title": "Obtain Upgrade Obsidian",
  "quest.24A7B0926B8A7E26.quest_desc": [
    "Gold to Diamond Furnace Upgrade — diamonds and glass around a gold ingot core.",
    "",
    "Sneak + right-click a gold furnace. Lands you at 80-tick smelting with tier 2 energy.",
    "",
    "Major skyblock milestone — diamonds from sieving or random block finally pay off.",
  ],
