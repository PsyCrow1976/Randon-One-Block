  "task.5C0E110A7E110021.title": "Mine to 50,000 Randon Mined",

  "quest.5C0E110A7E110030.title": "The Echo",
  "quest.5C0E110A7E110030.quest_subtitle": "100,000 — the void answers once",
  "quest.5C0E110A7E110030.quest_desc": [
    "The break that takes your team to &e100,000&r Randon Mined places &dThe Echo&r on the center block.",
    "",
    "You also receive the &dEcho Seal&r. Later center breaks go back to the normal random pool and do not grant The Echo again.",
    "",
    "If the counter was already past 100,000 before this chapter existed, the &enext&r center break grants it once."
  ],
  "task.5C0E110A7E110031.title": "Receive The Echo",

  "quest.5C0E110A7E110040.title": "The Randon Ending",
  "quest.5C0E110A7E110040.quest_subtitle": "Atlas Seal and Echo Seal",
  "quest.5C0E110A7E110040.quest_desc": [
    "Finish both endgames for this pack:",
    "• &eAtlas Seal&r — every active page in &6The Atlas&r",
    "• &dEcho Seal&r — 100,000 team Randon Mined",
    "",
    "Collection-heavy teams can finish the Atlas first. Mine-heavy teams can earn The Echo first. This quest completes when the team has both."
