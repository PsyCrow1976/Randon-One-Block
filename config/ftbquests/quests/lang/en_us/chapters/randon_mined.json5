    "&aCheck the box&r in the quest book, or use &f/randomblock unlock choose darkutils&r."
  ],
  "task.16688F671F62C49F.title": "Choose Dark Utilities (5k)",

  "quest.39A188E8418C47B7.title": "Claim Apotheosis (5k)",
  "quest.39A188E8418C47B7.quest_subtitle": "Spend 5k choice on Apotheosis package",
  "quest.39A188E8418C47B7.quest_desc": [
    "Spend &dchoice_5k&r on &6Apotheosis&r (+ Enchanting) if it is still locked.",
