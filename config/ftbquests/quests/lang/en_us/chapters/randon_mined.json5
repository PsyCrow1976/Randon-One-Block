{
  "quest.8F3A1C2E9B0D4E01.title": "The Void Counter",
  "quest.8F3A1C2E9B0D4E01.quest_subtitle": "Randon Mined basics",
  "quest.8F3A1C2E9B0D4E01.quest_desc": [
    "Every time you break your island's &6center random block&r, your team gains one &eRandon Mined&r.",
    "",
    "That count is &ashared for the whole island team&r (not per player). Watch the HUD above the hotbar, or run &f/randomblock counter&r.",
    "",
    "This chapter tracks &emine milestones&r: auto pool unlocks, &echoice tokens&r for mods without a full quest line, and tips for &f/randomblock milestones&r / &f/randomblock unlock list&r.",
    "",
    "Check the box when you have found the counter. Keep mining — the void is counting."
  ],
  "task.8F3A1C2E9B0D4T01.title": "Read about Randon Mined",

  "quest.8F3A1C2E9B0D4E02.title": "First Hundred",
  "quest.8F3A1C2E9B0D4E02.quest_subtitle": "100 Randon Mined",
  "quest.8F3A1C2E9B0D4E02.quest_desc": [
    "Reach &e100&r team Randon Mined by breaking the center block.",
    "",
    "This quest &acompletes automatically&r when your island hits the milestone (or when you open this tab after backfill).",
    "",
    "The void notices. Bigger unlocks come later."
  ],
  "task.8F3A1C2E9B0D4T02.title": "Reach 100 Randon Mined",

  "quest.8F3A1C2E9B0D4E03.title": "Utility Crack",
  "quest.8F3A1C2E9B0D4E03.quest_subtitle": "500 — BBL Utility pool",
  "quest.8F3A1C2E9B0D4E03.quest_desc": [
    "At &e500&r Randon Mined, &6BBL Utility&r (&futility&r) blocks &aautomatically join&r your team's random pool.",
    "",
    "No choice required — generators, breakers, placers, and related full-cube blocks can start rolling from the center block.",
    "",
    "Completes automatically when the milestone fires."
  ],
  "task.8F3A1C2E9B0D4T03.title": "Unlock BBL Utility @ 500",

  "quest.8F3A1C2E9B0D4E04.title": "First Crack in the Void",
  "quest.8F3A1C2E9B0D4E04.quest_subtitle": "1,000 — unlock choice",
  "quest.8F3A1C2E9B0D4E04.quest_desc": [
    "At &e1,000&r Randon Mined you earn an &dunlock choice token&r (&fchoice_1k&r).",
    "",
    "Pick &6one&r still-locked pool for your team:",
    "• &eDark Utilities&r (&fdarkutils&r)",
    "• &eApotheosis&r (&fapotheosis&r + &fapothic_enchanting&r)",
    "",
    "Open the side quests in this chapter and &echeck the box&r on the pool you want — that spends the token in the book.",
    "Or use chat: &f/randomblock unlock list&r then &f/randomblock unlock choose <mod>&r.",
    "",
    "This quest completes automatically when the token is granted."
  ],
  "task.8F3A1C2E9B0D4T04.title": "Reach 1,000 Randon Mined",

  "quest.8F3A1C2E9B0D4E05.title": "Claim Dark Utils (1k)",
  "quest.8F3A1C2E9B0D4E05.quest_subtitle": "Spend choice on darkutils",
  "quest.8F3A1C2E9B0D4E05.quest_desc": [
    "Spend your &d1,000&r choice token on &6Dark Utilities&r.",
    "",
    "&aCheck the box&r in the quest book to claim (same as &f/randomblock unlock choose darkutils&r).",
    "",
    "You only have &eone&r token at this tier — if you already spent it on Apotheosis, this claim will fail (expected)."
  ],
  "task.8F3A1C2E9B0D4T05.title": "Choose Dark Utilities",

  "quest.8F3A1C2E9B0D4E06.title": "Claim Apotheosis (1k)",
  "quest.8F3A1C2E9B0D4E06.quest_subtitle": "Spend choice on apotheosis package",
  "quest.8F3A1C2E9B0D4E06.quest_desc": [
    "Spend your &d1,000&r choice token on &6Apotheosis&r.",
    "",
    "This unlocks &fboth&r &eapotheosis&r and &eapothic_enchanting&r in the minable pool.",
    "",
    "&aCheck the box&r to claim (same as &f/randomblock unlock choose apotheosis&r).",
    "",
    "One token only — if you already spent it on Dark Utils, this claim will fail (expected)."
