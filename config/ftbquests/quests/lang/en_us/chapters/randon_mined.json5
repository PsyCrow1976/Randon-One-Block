{
  "quest.298C76D8B303A1D7.title": "The Void Counter",
  "quest.298C76D8B303A1D7.quest_subtitle": "How Randon Mined works",
  "quest.298C76D8B303A1D7.quest_desc": [
    "Every time you break your island's &6center random block&r, your team gains one &eRandon Mined&r.",
    "",
    "That count is &ashared for the whole island team&r (not per player). Watch the HUD above the hotbar, or run &f/randomblock counter&r.",
    "",
    "This chapter tracks &emine milestones&r:",
    "• &aAuto unlocks&r — some mods join the random pool when you hit a number (no choice).",
    "• &dChoice tokens&r — at 1,000 and 5,000 you pick a mod that has no full quest line.",
    "",
    "Commands if you need them: &f/randomblock milestones&r · &f/randomblock unlock list&r · &f/randomblock unlock choose <mod>&r.",
    "",
    "Check the box when you understand the counter, then keep mining."
  ],
  "task.40481E72B44FC263.title": "I found the Randon Mined counter",

  "quest.70A74D8F9AE4A94A.title": "First Hundred",
  "quest.70A74D8F9AE4A94A.quest_subtitle": "100 Randon Mined",
  "quest.70A74D8F9AE4A94A.quest_desc": [
    "Reach &e100&r team Randon Mined by breaking the center block.",
    "",
    "This quest &acompletes automatically&r when your island hits the milestone (or on login/backfill if you already passed it).",
    "",
    "The void notices. Bigger unlocks come later."
  ],
  "task.4F0A96F8B052E85E.title": "Reach 100 Randon Mined",

  "quest.354911A44E0FE192.title": "Utility Crack",
  "quest.354911A44E0FE192.quest_subtitle": "500 — BBL Utility joins the pool",
  "quest.354911A44E0FE192.quest_desc": [
    "At &e500&r Randon Mined, &6BBL Utility&r (&futility&r) blocks &aautomatically join&r your team's random pool.",
    "",
    "No choice required — resource generators, block breakers/placers, and related full-cube blocks can start rolling from the center block.",
    "",
    "Completes automatically when the milestone fires."
  ],
  "task.036077D54B54F1F1.title": "Unlock BBL Utility @ 500",

  "quest.4F8ACEF07DC37A1F.title": "First Crack in the Void",
  "quest.4F8ACEF07DC37A1F.quest_subtitle": "1,000 — pick a support mod",
  "quest.4F8ACEF07DC37A1F.quest_desc": [
    "At &e1,000&r Randon Mined you earn an &dunlock choice token&r (&fchoice_1k&r).",
    "",
    "Pick &6one&r still-locked pool for your team using the side quests:",
    "• &eClaim Dark Utils&r — Dark Utilities filters and gadgets",
    "• &eClaim Apotheosis&r — Apotheosis + Apothic Enchanting (both namespaces)",
    "",
    "Open a claim quest and &acheck the box&r to spend the token. You only get &eone&r pick at this tier.",
    "",
    "Or use chat: &f/randomblock unlock choose darkutils&r / &fapotheosis&r.",
    "",
    "This milestone quest completes automatically when the token is granted."
  ],
  "task.284BB242E685CD86.title": "Reach 1,000 Randon Mined",

  "quest.3406FF862E0E55FB.title": "Claim Dark Utils (1k)",
  "quest.3406FF862E0E55FB.quest_subtitle": "Spend choice on darkutils",
  "quest.3406FF862E0E55FB.quest_desc": [
    "Spend your &d1,000&r choice token on &6Dark Utilities&r.",
    "",
    "&aCheck the box&r to claim — same as running &f/randomblock unlock choose darkutils&r.",
    "",
    "Dark Utils blocks can then roll from the center random block for your team.",
    "",
    "If you already spent the token on Apotheosis, this claim will fail (expected — one token only)."
  ],
  "task.70C16F9FB9166093.title": "Choose Dark Utilities",

  "quest.32BD86CB337AB9F0.title": "Claim Apotheosis (1k)",
  "quest.32BD86CB337AB9F0.quest_subtitle": "Spend choice on Apotheosis package",
  "quest.32BD86CB337AB9F0.quest_desc": [
    "Spend your &d1,000&r choice token on &6Apotheosis&r.",
    "",
    "This unlocks &fboth&r &eapotheosis&r and &eapothic_enchanting&r in the minable pool (shelves, salvaging table, and related full cubes).",
    "",
    "&aCheck the box&r to claim — same as &f/randomblock unlock choose apotheosis&r.",
    "",
    "If you already spent the token on Dark Utils, this claim will fail (expected)."
  ],
  "task.2F21027BA89D32B8.title": "Choose Apotheosis package",

  "quest.052F6E722C91858A.title": "Ore in the Tear",
  "quest.052F6E722C91858A.quest_subtitle": "2,500 — Easy Ore Generation",
  "quest.052F6E722C91858A.quest_desc": [
    "At &e2,500&r Randon Mined, &6Easy Ore Generation&r (&feasyoregeneration&r) &aautomatically joins&r the random pool.",
