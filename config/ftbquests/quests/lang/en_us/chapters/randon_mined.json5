  "task.8F3A1C2E9B0D4T09.title": "Choose Dark Utilities (5k)",

  "quest.8F3A1C2E9B0D4E0A.title": "Claim Apotheosis (5k)",
  "quest.8F3A1C2E9B0D4E0A.quest_subtitle": "Spend 5k choice on apotheosis package",
