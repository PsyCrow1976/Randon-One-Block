  "task.8F3A1C2E9B0D4T06.title": "Choose Apotheosis package",

  "quest.8F3A1C2E9B0D4E07.title": "Ore in the Tear",
  "quest.8F3A1C2E9B0D4E07.quest_subtitle": "2,500 — Easy Ore Generation",
  "quest.8F3A1C2E9B0D4E07.quest_desc": [
