{
  "chapter.5053B37E4642C6D9.title": "Apotheosis",
  "quest.4F2FFDBB7BCC353B.title": "Augmenting Table",
  "quest.4F2FFDBB7BCC353B.quest_desc": [
    "Augmenting Table \u2014 improves existing affixes on an item using Sigils of Enhancement.",
    "",
    "Unlike rebirth (reroll), augmentation strengthens the stats you already rolled. Save your best base affix combo before augmenting.",
    "",
    "Pairs with salvaging and gem socketing for endgame gear crafting."
  ],
  "task.FA38E65906A258BD.title": "Obtain Augmenting Table",
  "quest.0EB14389DD29B1C0.title": "Gem Case of House Faberg\u00e9",
  "quest.0EB14389DD29B1C0.quest_desc": [
    "Gem Case of House Faberg\u00e9 \u2014 premium gem storage with expanded upgrade options.",
    "",
    "End-game gem management for players running multiple socketed loadouts. Craft when your affix gear set is mature and gem types multiply."
  ],
  "task.45B59F8E89F26E8F.title": "Obtain Gem Case of House Faberg\u00e9",
  "quest.71D6A64A2BBF6B7A.title": "Gem Case",
  "quest.71D6A64A2BBF6B7A.quest_desc": [
    "Gem Case \u2014 bulk storage and batch upgrade for Apothic Gems of the same type.",
    "",
    "Upgrade many gems at once when you have the materials, saving repetitive Gem Cutting Table clicks.",
    "",
    "Tooltip shows capacity and unique gem count \u2014 use before you overflow your inventory with flawed gems from loot."
  ],
  "task.E3E5CCE186801549.title": "Obtain Gem Case",
  "quest.F147C9CF5FAEB077.title": "Gem Cutting Table",
  "quest.F147C9CF5FAEB077.quest_desc": [
    "Gem Cutting Table \u2014 upgrades Apothic Gem purity (Cracked \u2192 Chipped \u2192 Flawed \u2192 Flawless \u2192 Perfect).",
    "",
    "Costs Gem Dust plus rarity materials from salvaging. Perfect gems unlock the Infinity Stones advancement line.",
    "",
    "Central station for socketing build \u2014 cut gems before inserting with Sigil of Socketing."
  ],
  "task.6D1BE23249695502.title": "Obtain Gem Cutting Table",
  "quest.2A8CCBC70DDEBC80.title": "Reforging Table",
  "quest.2A8CCBC70DDEBC80.quest_desc": [
    "Advanced Reforging Table \u2014 full affix rerolling with material costs shown in JEI.",
    "",
    "Core loop of Apotheosis gear progression: find affixed loot, spend Sigils of Rebirth, push items toward Rare, Epic, and Mythic tiers.",
    "",
    "Station-place near your mob farm so fresh drops get upgraded immediately."
  ],
  "task.C6024CB9A674F72E.title": "Obtain Reforging Table",
  "quest.C87E129EF983807D.title": "Salvaging Table",
  "quest.C87E129EF983807D.quest_desc": [
    "Salvaging Table \u2014 breaks down affixed gear into rarity materials and Gem Dust.",
    "",
    "Recycle junk affix drops from mob farms instead of trashing them. Materials feed the Gem Cutting Table and high-tier sigil crafts.",
    "",
    "Check JEI for which rarity scraps each item tier returns."
  ],
  "task.46FDB78E27185716.title": "Obtain Salvaging Table",
  "quest.7FA593FBD86EDF21.title": "Simple Reforging Table",
  "quest.7FA593FBD86EDF21.quest_desc": [
    "Entry-level Reforging Table for rerolling Apothic Affixes on equipment.",
    "",
    "Fuel with Sigils of Rebirth. Toss in swords, axes, bows, or armor from mob drops and random-block loot to chase better prefixes and suffixes.",
    "",
    "Upgrade to the full Reforging Table later for more control over reroll outcomes."
  ],
  "task.C0BA08AB8B48FB1E.title": "Obtain Simple Reforging Table",
  "quest.4E06D12682EC262D.title": "Manifestation of Infinity",
  "quest.4E06D12682EC262D.quest_desc": [
    "Manifestation of Infinity \u2014 ultimate gem-cutting material for Perfect-tier gemstones.",
    "",
    "Required to push gems to Perfect purity at the Gem Cutting Table. Major endgame chase item for min-maxers."
  ],
  "task.BB82EF80CA9A4993.title": "Obtain Manifestation of Infinity",
  "quest.D910EAF1DF9B0AA6.title": "Gem",
  "quest.D910EAF1DF9B0AA6.quest_desc": [
    "Base Apothic Gem item \u2014 any gem type or purity counts toward this quest.",
    "",
    "Gems socket into Affix Items via the Sigil of Socketing or Smithing Table recipes. Each gem type grants different bonuses (check JEI for Ballast, Samurai, Inferno, etc.).",
    "",
    "Loot from Apothic Invaders, chests, and random-block structures."
  ],
  "task.9B77A69CC6D5072D.title": "Obtain Gem",
  "quest.23D4950FDF426BA9.title": "Gem Dust",
  "quest.23D4950FDF426BA9.quest_desc": [
    "Gem Dust \u2014 crushed gemstone powder from salvaging Apothic Gems or gear.",
    "",
    "Primary fuel for the Gem Cutting Table. Stockpile by salvaging flawed gems you will not socket."
  ],
  "task.0FE1598305495504.title": "Obtain Gem Dust",
  "quest.2591808AA0B3FEF1.title": "Gem-Fused Slate",
  "quest.2591808AA0B3FEF1.quest_desc": [
    "Gem-Fused Slate \u2014 crafting component for high-tier Apotheosis recipes.",
    "",
    "Check JEI for exact uses in your pack version \u2014 typically bridges gems into advanced sigils and station upgrades."
  ],
  "task.77A4DCB12CF1B11A.title": "Obtain Gem-Fused Slate",
  "quest.4662CE5DE687F2A2.title": "Ballast Gem",
  "quest.4662CE5DE687F2A2.quest_desc": [
    "Ballast Gem \u2014 socketable Apothic Gemstone with affix bonuses tied to this gem line.",
    "",
    "Purity tiers (Cracked through Perfect) scale the stats. Cut upgrades at the Gem Cutting Table using Gem Dust and salvaged materials.",
    "",
    "Region: core. Insert with Sigil of Socketing or unsocket with Vials at a Smithing Table (gems may be destroyed \u2014 read JEI carefully)."
  ],
  "task.1B45E8CD8C2E1AC1.title": "Obtain Ballast Gem",
