{
  "quest.73B3ADDEEBEF97B0.title": "The Atlas",
  "quest.73B3ADDEEBEF97B0.quest_subtitle": "Center-block discovery list",
  "quest.73B3ADDEEBEF97B0.quest_desc": [
    "This chapter is the &6Randon Atlas&r checklist — curated &eendgame blocks&r that count when they roll from your island &acenter random block&r.",
    "",
    "Each quest below is one Atlas page. It completes when that block is rolled for your team (reward &e10 XP&r).",
    "",
    "Also use chat: &f/randomblock atlas&r and &f/randomblock atlas missing&r.",
    "",
    "Unlocking mod pools can &aexpand&r which pages count for full completion.",
  ],
  "task.3E8A97F7E9DD75C1.title": "Open the Atlas checklist",
